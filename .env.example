# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# --- Database (PostgreSQL 14+) ---
DATABASE_URL="postgresql://storefront:CHANGE_ME@localhost:5432/storefront"

# --- Auth (Better Auth) ---
# At least 32 random characters. Rotating it signs every admin out.
BETTER_AUTH_SECRET=""
# Public origin of the site; used for auth callbacks, canonical URLs, sitemap and Stripe redirects.
BETTER_AUTH_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# --- Image storage ---
# "local" writes to LOCAL_STORAGE_DIR (development only). "s3" uses any S3-compatible service.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# Required for STORAGE_DRIVER=local: signs short-lived upload tokens (32+ chars).
UPLOAD_SIGNING_SECRET=""
MAX_UPLOAD_MB="10"

# Required for STORAGE_DRIVER=s3
S3_BUCKET=""
S3_REGION=""
# Leave empty for AWS. Set for MinIO / R2 / Spaces, e.g. http://localhost:9000
S3_ENDPOINT=""
# Only when browsers reach the storage service at a different address than the server does
# (e.g. Docker Compose: server uses http://minio:9000, browser uses http://localhost:9000).
S3_UPLOAD_ENDPOINT=""
# "true" for MinIO and most self-hosted services
S3_FORCE_PATH_STYLE="false"
# Optional: falls back to the default AWS credential chain (IAM role, env, profile).
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public URL that serves bucket objects (bucket URL or CDN), without trailing slash.
S3_PUBLIC_BASE_URL=""

# --- Payments (optional) ---
# Checkout stays disabled (with a clear message) until BOTH are set. Use sk_test_ keys first.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Networking ---
# "true" only behind a reverse proxy you control that sets X-Forwarded-For (used for rate limiting).
TRUST_PROXY="false"

# --- Admin bootstrap (only read by `npm run admin:create`; prefer the interactive prompt) ---
# ADMIN_PASSWORD=""
